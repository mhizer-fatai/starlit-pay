# Server Port
PORT=3001

# CORS: exact frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://starlit-pay.netlify.app,http://localhost:5173,http://localhost:5175,http://localhost:3000
# CUSTOM_DOMAIN=https://starlitpay.xyz,https://www.starlitpay.xyz

# Supabase
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Backend uses the SECRET service-role key (Supabase > Project Settings > API). Never the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Passkey sign-in (disabled until both secrets are set)
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
# 64 hex chars. Keep it outside the database: it protects PIN verifiers and recovery codes.
# Changing it invalidates every PIN. Every server sharing the database must use the same value.
PIN_PEPPER_KEY=
# WebAuthn relying party = the domain users see in the address bar (no scheme or port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Starlit Pay
# Exact frontend origins allowed to complete passkey ceremonies (comma-separated)
WEBAUTHN_ORIGINS=http://localhost:5173
# Session cookies. Use lax with a same-site API (e.g. the Netlify /api proxy).
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# COOKIE_DOMAIN=
# Proxy hops in front of the API (1 on Render, 2 via the Netlify proxy)
# TRUST_PROXY=1

# Database connection pooling (Supavisor / HTTP keep-alive)
DB_POOL_MAX_SOCKETS=50
DB_POOL_TIMEOUT_MS=30000
DB_POOL_MODE=transaction
SUPABASE_POOLER_PORT=6543

# Stellar (testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Label used in relayer alerts only
STELLAR_NETWORK=TESTNET

# Private pools (real ZK, SPP contracts), one per asset. Defaults are testnet.
# ZK_POOL_XLM=CBPXO3XY6DVA4K6MU3K2JFYUOLUBFOMP2ACFFNVUP5LQZUZXFSTABPUX
# ZK_POOL_USDC=CBRXBWOEVQRNP7ZLGUTKG5UQBEFSOLLVHV4UEEVBKRPECB763YGHANLY

# Relayer: pays the fees for private payments and smart-wallet transactions
RELAYER_SECRET_KEY=
RELAYER_WARN_THRESHOLD_XLM=50
RELAYER_CRITICAL_THRESHOLD_XLM=15
RELAYER_MONITOR_INTERVAL_MS=60000
# Optional webhook for low-balance alerts (Slack/Discord/Telegram)
# RELAYER_ALERT_WEBHOOK_URL=

# Channel accounts: let many payments (and faucet claims) go through at once.
# Their keys come from the relayer key. The server creates them (20 XLM each from
# the relayer), keeps them funded, and uses them once they exist. Needs the
# background jobs, so a local server with BACKGROUND_JOBS=off never uses them.
# 0 or unset = everything on the relayer account. Set it on ONE server only:
# leases live in that server's memory.
# CHANNEL_COUNT=10

# Deposit gateway: payments with a user's memo (and their smart wallet's
# transfers) become credits their device deposits into the private pools.
# Needs sql/schema_zk_gateway.sql.
GATEWAY_SECRET_KEY=
# GATEWAY_PUBLIC_KEY=   (defaults to the gateway key's address)

# Testnet faucet: pays 10 XLM + 20 USDC to the gateway for the signed-in user
FAUCET_SECRET_KEY=
# Cloudflare Turnstile secret. Leave unset to skip the captcha; set it before mainnet.
# TURNSTILE_SECRET_KEY=

# Compliance screening contract (ASP). Unset: only the built-in blocklist applies.
# ASP_CONTRACT_ID=

# Background jobs (gateway, indexer, TTL keeper). Set to "off" for a local server
# that shares a database with production, so deposits are never processed twice.
# BACKGROUND_JOBS=off

# Observability
# LOG_FORMAT=json          (default: json in production, readable text in a terminal)
# METRICS_TOKEN=           (enables GET /api/metrics with "Authorization: Bearer <token>")

# Prices (optional): CoinGecko is the fallback after the Stellar DEX
# COINGECKO_API_KEY=

# Closed beta ("Founding Testers")
# on = new accounts need an approved application email or an invite code;
# existing accounts are unaffected
BETA_INVITE_ONLY=off
# Comma-separated emails that may review applications and create invite codes
ADMIN_EMAILS=
# The Founding Testers Telegram group, shown only to approved applicants
BETA_TELEGRAM_URL=
# Resend (resend.com) API key: emails approved applicants "you're in" (optional)
RESEND_API_KEY=
# Sender of those emails, on a domain verified in Resend
MAIL_FROM=Starlit Pay <hello@starlitpay.xyz>
# Links in emails
APP_URL=https://starlitpay.xyz
