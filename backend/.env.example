# Server Port
PORT=3001

# Production Custom Domain and CORS (comma-separated origins)
CUSTOM_DOMAIN=https://starlitpay.com,https://app.starlitpay.com
ALLOWED_ORIGINS=https://starlit-pay.netlify.app,http://localhost:5173,http://localhost:5175,http://localhost:3000

# Supabase Configurations
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Backend uses the SECRET service-role key (Supabase > Project Settings > API). Never the anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Deprecated fallback; leave unset once SUPABASE_SERVICE_ROLE_KEY is configured
# SUPABASE_ANON_KEY=
JWT_SECRET=your_jwt_signing_secret_here

# Passkey auth layer (disabled until both secrets are set; never reuse JWT_SECRET)
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
# 64 hex chars. Keep it outside the database: it protects PIN verifiers. Changing it invalidates every PIN.
PIN_PEPPER_KEY=
# WebAuthn relying party = the domain users see in the address bar (no scheme or port)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Starlit Pay
# Exact frontend origins allowed to complete passkey ceremonies (comma-separated)
WEBAUTHN_ORIGINS=http://localhost:5173
# Session cookies. Use lax with a same-site API (e.g. the Netlify /api proxy).
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# COOKIE_DOMAIN=
# Proxy hops in front of the API (1 on Render, 2 via the Netlify proxy)
# TRUST_PROXY=1

# Database Connection Pooling Options (Supavisor / HTTP Keep-Alive)
DB_POOL_MAX_SOCKETS=50
DB_POOL_TIMEOUT_MS=30000
DB_POOL_MODE=transaction
SUPABASE_POOLER_PORT=6543

# Stellar Network Settings
# Can be TESTNET or MAINNET
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Shielded Pool Soroban Contract ID
# Deployed contract ID on Stellar
SHIELDED_POOL_CONTRACT_ID=CAHSOWD7JVCRO4U73MGXRET7DRJDM3K2CFS5EGYARWDEGACHWSR6ZEZM

# Relayer Secret Key for Gas Sponsorship
RELAYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Automated Relayer Gas Monitoring Daemon Settings
RELAYER_WARN_THRESHOLD_XLM=50
RELAYER_CRITICAL_THRESHOLD_XLM=15
RELAYER_MONITOR_INTERVAL_MS=60000
# Optional webhook for real-time low gas alerts (Slack/Discord/Telegram webhook URL)
# RELAYER_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Pool TTL keeper: how often the relayer calls the contract bump() (default 24h)
# TTL_KEEPER_INTERVAL_MS=86400000

# Gateway Secret Key for Auto-Shielding Gateway
GATEWAY_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Admin Credentials
ADMIN_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudflare Turnstile secret for faucet captcha (test value always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
